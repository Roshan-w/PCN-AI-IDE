[Unit]
Description=PCN AI IDE API Gateway
After=network.target

[Service]
Type=simple
User=pcn-ai
Group=pcn-ai
WorkingDirectory=/opt/pcn-ai-ide/packages/api/gateway

ExecStart=/opt/pcn-ai-ide/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
